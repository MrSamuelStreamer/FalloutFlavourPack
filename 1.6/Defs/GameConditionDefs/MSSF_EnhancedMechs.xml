<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GameConditionDef>
        <defName>MSSF_EnhancedMechs</defName>
        <conditionClass>MSSFP.BuffGameCondition</conditionClass>
        <label>mechs enhanced</label>
        <description>Your mechanoids have been greatly enhanced.</description>
        <letterText>After activating The Platinum Chip, advanced algorithms hidden deep within your mechanoids cores have been activated, enabling greatly enhanced functioning.</letterText>
        <letterDef>PositiveEvent</letterDef>
        <canBePermanent>true</canBePermanent>
        <natural>false</natural>
        <allowUnderground>true</allowUnderground>
        <modExtensions>
            <li Class="MSSFP.ModExtensions.GameConditionModExtension"> 
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetMechs>true</canTargetMechs>
                <canTargetHumans>false</canTargetHumans>
                <canTargetSubhumans>false</canTargetSubhumans>
                <canTargetEntities>false</canTargetEntities>
                <canTargetBloodfeeders>false</canTargetBloodfeeders>
                <mustTargetPlayerFaction>true</mustTargetPlayerFaction>
                <hediffsToApply>
                    <li>MSSF_EnhancedMechs</li>
                </hediffsToApply>
            </li>
        </modExtensions>
    </GameConditionDef>

    
  <ThingDef ParentName="BaseBullet">
    <defName>MSSF_Bullet_Rocket</defName>
    <label>rocket</label>
    <graphicData>
      <texPath>Things/Projectile/Rocket_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Bomb</damageDef>
      <!-- Use default damage from explosion def -->
      <explosionRadius>3.1</explosionRadius>
      <speed>38</speed>
    </projectile>
  </ThingDef>

  <AbilityDef>
    <defName>MSSF_PlatinumRocket</defName>
    <label>launch rocket</label>
    <description>launch a rocket at the target</description>
    <iconPath>Things/Item/Equipment/WeaponRanged/RocketLauncher</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
        <verbClass>Verb_ShootOneUse</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MSSF_Bullet_Rocket</defaultProjectile>
        <forcedMissRadius>3.4</forcedMissRadius>
        <defaultCooldownTime>5</defaultCooldownTime>
        <warmupTime>4.5</warmupTime>
        <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
        <range>30</range>
        <ticksBetweenBurstShots>120</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>InfernoCannon_Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <onlyManualCast>false</onlyManualCast>
        <stopBurstWithoutLos>false</stopBurstWithoutLos>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>10</muzzleFlashScale>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Bullet_Rocket</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>PiercingSpine</defName>
    <label>keratin spine</label>
    <graphicData>
      <texPath>Things/Projectile/PiercingSpine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>RangedStab</damageDef>
      <damageAmountBase>30</damageAmountBase>
      <armorPenetrationBase>1</armorPenetrationBase>
      <stoppingPower>1</stoppingPower>
      <speed>55</speed>
    </projectile>
  </ThingDef>

    <HediffDef ParentName="DiseaseBase">
        <defName>MSSF_EnhancedMechs</defName>
        <label>platinum enhancement</label>
        <description>The Platinum Chip has unlocked deep enhancements in this mechs programming</description>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <label>Enhancement</label>
                <statOffsets/>
                <statFactors>
                    <IncomingDamageFactor>0.38</IncomingDamageFactor>
                    <MeleeDamageFactor>1.9</MeleeDamageFactor>
                    <MoveSpeed>2.55</MoveSpeed>
                    <WorkSpeedGlobal>2.8</WorkSpeedGlobal>
                    <BandwidthCost>0.25</BandwidthCost>
                    <ControlTakingTime>0.25</ControlTakingTime>
                    <MechEnergyUsageFactor>0.25</MechEnergyUsageFactor>
                    <MechEnergyLossPerHP>0.15</MechEnergyLossPerHP>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_GiveAbility">
                <abilityDefs>
                <li>MSSF_PlatinumRocket</li>
                </abilityDefs>
            </li>
        </comps>
    </HediffDef>
</Defs>